import numpy as np

def main():
    arr = np.random.randint(10, 51, size=15)
    print("Original array:")
    print(arr)
    print()

    greater_than_25 = arr[arr > 25]
    print("Elements greater than 25:")
    print(greater_than_25)
    print()

    replaced = np.where(arr < 30, 0, arr)
    print("Array with elements < 30 replaced by 0:")
    print(replaced)
    print()

    count_div5 = np.sum(arr % 5 == 0)
    print("Number of elements divisible by 5:")
    print(count_div5)

if __name__ == "__main__":
    main()
