import csv
#2D array
data = [
    ["Name", "Age", "City"],
    ["Alice", 30, "New York"],
    ["Bob",   25, "Paris"],
    ["Carol", 27, "Tokyo"],
]
output_file = "people.csv"
# Write
with open(output_file, mode="w", newline="", encoding="utf-8") as f:
    writer = csv.writer(f)
    writer.writerows(data)
print(f"Wrote {len(data)-1} records to {output_file!r}")
read_data = []
#Read
with open(output_file, mode="r", newline="", encoding="utf-8") as f:
    reader = csv.reader(f)
    for row in reader:
        read_data.append(row)
print("Data read from CSV:")
for row in read_data:
    print(row)
