import numpy as np

def main():
    A = np.random.randint(1, 21, size=5)
    B = np.random.randint(1, 21, size=5)

    print("Array A:", A)
    print("Array B:", B)
    print()

    print("A + B =", A + B)
    print("A - B =", A - B)
    print("A * B =", A * B)
    print("A / B =", A / B)
    print()

    dot = np.dot(A, B)
    print("Dot product A · B =", dot)
    print()

    mean_A = A.mean()
    median_A = np.median(A)
    std_A = A.std()
    var_A = A.var()
    print("Statistics of A:")
    print(f"  Mean:               {mean_A}")
    print(f"  Median:             {median_A}")
    print(f"  Standard deviation: {std_A}")
    print(f"  Variance:           {var_A}")
    print()

    max_B = B.max()
    min_B = B.min()
    idx_max_B = B.argmax()
    idx_min_B = B.argmin()
    print("Array B extremes:")
    print(f"  Maximum value: {max_B} at index {idx_max_B}")
    print(f"  Minimum value: {min_B} at index {idx_min_B}")

if __name__ == "__main__":
    main()
