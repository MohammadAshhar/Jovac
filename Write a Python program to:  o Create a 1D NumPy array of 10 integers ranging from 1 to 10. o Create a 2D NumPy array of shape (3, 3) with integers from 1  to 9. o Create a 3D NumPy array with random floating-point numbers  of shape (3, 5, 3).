import numpy as np
def main():
    arr1d = np.arange(1, 11)
    print("1D array (1 to 10):")
    print(arr1d, end="\n\n")
    arr2d = np.arange(1, 10).reshape((3, 3))
    print("2D array (3×3, 1 to 9):")
    print(arr2d, end="\n\n")
    arr3d = np.random.random(size=(3, 5, 3))
    print("3D array (3×5×3, random floats):")
    print(arr3d)

if __name__ == "__main__":
    main()
